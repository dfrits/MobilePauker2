<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/lTimerFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/lTimerBarFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="100">

            <RelativeLayout
                android:id="@+id/UKZGTimerFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="UselessParent">

                    <TextView
                        android:id="@+id/UKZGTimerBarDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/ustm"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <!-- FrameLayout zum Stacken von ProgressBar + Text -->
                    <FrameLayout
                        android:id="@+id/UKZGTimerBarContainer"
                        android:layout_width="120dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="5dp">

                        <ProgressBar
                            android:id="@+id/UKZGTimerBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/timer_bar_background"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/timer_bar_foreground" />

                        <TextView
                            android:id="@+id/UKZGTimerBarText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="0%"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- KZG identisch -->
            <RelativeLayout
                android:id="@+id/KZGTimerFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="UselessParent">

                    <TextView
                        android:id="@+id/KZGTimerBarDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/stm"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:id="@+id/KZGTimerBarContainer"
                        android:layout_width="120dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="5dp">

                        <ProgressBar
                            android:id="@+id/KZGTimerBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/timer_bar_background"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/timer_bar_foreground" />

                        <TextView
                            android:id="@+id/KZGTimerBarText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="0%"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/lTimerBarFrame"
            android:layout_marginBottom="5dp"
            android:background="@android:color/darker_gray" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tAllCards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lTimerFrame"
        android:layout_marginStart="10dp"
        android:fontFamily="serif"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tUKZGCards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tAllCards"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/tAllCards"
        android:fontFamily="serif"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tKZGCards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tAllCards"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/tUKZGCards"
        android:fontFamily="serif"
        android:textColor="@color/black"
        android:textSize="14sp" />
</merge>